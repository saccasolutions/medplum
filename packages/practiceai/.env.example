# PracticeAI compose stack overrides (docker-compose.practiceai.yml). SYNTHETIC / DEV ONLY.
#
#   cp packages/practiceai/.env.example packages/practiceai/.env     # .env is gitignored (repo .gitignore)
#   docker compose --env-file packages/practiceai/.env -f docker-compose.practiceai.yml --profile stack up -d
#
# Every value is optional: the compose file has a synthetic dev default for each. Never put real
# credentials or PHI here; production secrets live in the deployment's secret manager.
# The billing integration client secret is NOT configured here: the practiceai-provision job creates
# it at runtime and hands MEDPLUM_PROJECTS to the billing container through a shared volume.

# --- Paths -------------------------------------------------------------------------------------
# Build context of the companion billing app (relative to the repo root or absolute).
BILLING_DIR=../billing

# --- Published ports -----------------------------------------------------------------------------
PRACTICEAI_PG_PORT=5432
PRACTICEAI_REDIS_PORT=6379
PRACTICEAI_SERVER_PORT=8103
PRACTICEAI_APP_PORT=3000
PRACTICEAI_BILLING_PORT=3100

# --- Medplum server ------------------------------------------------------------------------------
# Public URLs (what browsers use). The billing container talks to http://medplum-server:8103/.
MEDPLUM_PUBLIC_BASE_URL=http://localhost:8103/
MEDPLUM_APP_PUBLIC_BASE_URL=http://localhost:3000/
MEDPLUM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# Backing service passwords (dev values; change for anything shared).
POSTGRES_PASSWORD=medplum
REDIS_PASSWORD=medplum

# --- Provisioning job ----------------------------------------------------------------------------
# Seeded dev super admin (packages/server/src/seed.ts). Change it in the Medplum app after first boot.
MEDPLUM_ADMIN_EMAIL=admin@example.com
MEDPLUM_ADMIN_PASSWORD=medplum_admin
# Billing organization UUID to provision (default: the billing app's DEMO_ORG_ID).
PRACTICEAI_ORG_ID=d0000000-0000-4000-8000-00000000d001
PRACTICEAI_PRACTICE_NAME=Example Test PT Clinic

# --- Billing app -----------------------------------------------------------------------------------
# HMAC key for demo session cookies (blank: random per process, sessions reset on restart).
DEMO_SESSION_SECRET=
